# ===== required =====
RPC_URL=https://api.mainnet-beta.solana.com   # pakai RPC private (Helius/Triton/QuickNode) buat live
WALLET_PRIVATE_KEY=            # base58 atau JSON array 64 byte. WALLET KHUSUS BOT, modal terbatas.

# ===== execution =====
DRY_RUN=true                   # true = paper trading (saldo virtual 10 SOL), tidak kirim tx
INTERVAL_MS=60000              # jeda antar siklus
DATABASE_URL=postgresql://USER@localhost:5432/lp-agent   # wajib (Prisma). Dari Docker: postgresql://USER@host.docker.internal:5432/lp-agent
STATE_FILE=data/state.json     # hanya dibaca `npm run import-legacy` (format penyimpanan lama)
JOURNAL_FILE=data/journal.jsonl
PRIORITY_FEE_MICROLAMPORTS=200000
SLIPPAGE_PCT=1                 # active-bin slippage saat add liquidity
SWAP_SLIPPAGE_BPS=300          # zap-out token → SOL via Jupiter (auto naik 2x/4x kalau gagal)
TX_MAX_RETRIES=3
RESERVE_SOL=0.15               # selalu disisakan buat rent + fee

# ===== opening / sizing (Modul 9) =====
OPENING_ENABLED=true
MAX_POSITIONS=5                # basket diversifikasi (Modul 6 S3)
MAX_DEPLOYED_PCT=60            # maksimal % bankroll yang dipasang sekaligus
MIN_POSITION_SOL=0.1
MAX_POSITION_SOL=2
MAX_BINS_PER_POSITION=140      # >69 bins = extended position (rent lebih besar, refundable)
MAX_BIN_ARRAY_COST_SOL=0.2     # rent bin array baru (TIDAK balik) — skip kalau lebih mahal
OPEN_COOLDOWN_MS=7200000       # jangan buka lagi pool yang sama 2 jam setelah close
ALLOW_AGGRESSIVE=false         # izinkan S4 heart-attack tight spot (risiko sangat tinggi)
WEEKEND_SIZE_FACTOR=0.7        # Sabtu volume sepi → size dikecilin

# ===== screening (Modul 5) =====
SCREEN_PAGE_SIZE=150
MIN_TVL_USD=10000
MAX_TVL_USD=5000000
MIN_MCAP_USD=1000000           # filter holiday: mcap > $1M
MAX_MCAP_USD=5000000           # mcap di atas ini dilewati (0 = tanpa batas atas)
MIN_AGE_HOURS=24               # filter holiday: umur ≥ 1 hari
MAX_AGE_HOURS=0                # hanya token lebih muda dari ini (0 = tanpa batas), harus > MIN_AGE_HOURS
MIN_VOLUME_1H_USD=30000
MIN_FEE_TVL_24H_PCT=3
MIN_BIN_STEP=50                # memecoin butuh bin step lebar biar range −65% muat
DEEP_CHECK_COUNT=8             # kandidat teratas yang diserahkan ke AI (atau dicek rule engine) per siklus
BLOCKED_MINTS=
USE_GMGN=true                  # kandidat dari GMGN hot searches (script/gmgn_hot_searches.py, butuh: pip install curl_cffi)
GMGN_INTERVAL=1h               # 1m / 5m / 1h / 6h / 24h
GMGN_MAX_TOKENS=50             # token teratas hot searches yang dicari pool DLMM-nya
PYTHON_BIN=python3

# ===== risk / exits (Modul 8–9) =====
DAILY_LOSS_LIMIT_SOL=1         # stop buka posisi baru kalau rugi hari ini segini
DAILY_PROFIT_STOP_SOL=0        # 0 = off. "abis hari hijau gede, berhenti"
SOL_DUMP_1H_PCT=4              # SOL turun ≥4%/1h atau ≥10%/24h → close semua, pause
SOL_DUMP_24H_PCT=10
RUG_CANDLE_PCT=40              # 1 candle 15m turun ≥40% → jual langsung
OOR_BELOW_MAX_MIN=30           # (dipakai per strategi) maksimal menit di bawah range
IDLE_ABOVE_MAX_MIN=90          # range nggak pernah kesentuh → tutup & re-range
VOLUME_DECAY_RATIO=0.25        # volume 1h < 25% rata-rata per jam 24h → exit
CLAIM_FEE_MIN_SOL=0.05
SELL_FEE_TOKENS=true           # claim & jual fee token langsung (Modul 8.1)

# ===== AI decision loop: DeepSeek (opsional) =====
DEEPSEEK_API_KEY=              # diisi = AI yang memilih entry (pool, bin step, range, size). Kosong = rule engine.
# LLM_ENABLED=false            # matikan AI walau key ada
LLM_MODEL=deepseek-chat        # atau deepseek-reasoner (lebih lambat, mikir lebih dalam)
LLM_TIMEOUT_MS=60000           # per panggilan model
LLM_MAX_STEPS=14               # maksimal putaran tool-calling per siklus sebelum dianggap tidak buka
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== Telegram notif (opsional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== dashboard API (dipakai frontend/) =====
API_ENABLED=true
API_HOST=127.0.0.1             # docker-compose men-set 0.0.0.0 (wajib isi API_TOKEN)
API_PORT=8787
API_TOKEN=                     # string acak panjang, mis. hasil: openssl rand -hex 24
API_CORS_ORIGIN=*              # hanya relevan kalau frontend di domain berbeda
